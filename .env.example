# Copy to .env and fill in your real values
# Get these at https://app.supabase.com → your project → Settings → API

# Supabase project URL (never changes)
SUPABASE_URL=https://your-project.supabase.co

# Secret key — used by backend scrapers (full DB access, never expose to browser)
# Supabase Dashboard → Settings → API → Secret key (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_...

# Publishable key — safe for client-side / dashboard use
# Supabase Dashboard → Settings → API → Publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Set to true to run Playwright in headed mode (for local debugging)
PLAYWRIGHT_HEADLESS=true
